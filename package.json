{
    "name": "bambu",
    "private": true,
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "dev": "bun --watch --filter @bambu/dev dev",
        "dev2": "bun --env-file=./packages/dev/.env ./packages/dev/src/index.html",
        "dev3": "bun --hot --env-file=./packages/dev/.env ./packages/dev/index.ts"
    },
    "dependencies": {
        "chroma-js": "^3.2.0",
        "nanoid": "^6.0.1"
    },
    "devDependencies": {
        "@types/chroma-js": "^3.1.2"
    }
}
