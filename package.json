{
    "name": "bambu",
    "private": true,
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "dev:ts": "bun run --hot ./packages/dev/index.ts",
        "dev:scss": "npx sass ./packages/dev/src/theme/theme.scss ./packages/dev/src/theme/theme.css --watch",
        "dev": "bun run dev:ts & bun run dev:scss"
    },
    "dependencies": {
        "chroma-js": "^3.2.0",
        "nanoid": "^6.0.1"
    },
    "devDependencies": {
        "@types/chroma-js": "^3.1.2"
    }
}
